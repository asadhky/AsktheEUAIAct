# Ask the EU AI Act: configuration.
#
# Copy to `.env` (which is gitignored) and fill in what you need. Never commit real secrets.
# Run backend commands from the repository root so that this `.env` is found.
# A blank value (`NAME=`) means "unset": the built-in default applies, or there is none.
# Every variable in backend/askact/config.py is listed here; a test keeps the two in sync.

# --- Ingestion (build time) ---------------------------------------------------
# Where ingestion fetches the Official Journal text of Regulation (EU) 2024/1689
# (CELEX 32024R1689, published 12 July 2024). This is the original text, not a consolidated version.
# It is the Publications Office's resource URL; the eur-lex.europa.eu HTML page answers automated
# clients with a bot-challenge page, so it is not used. The request asks for XHTML in English.
SOURCE_URL=https://publications.europa.eu/resource/celex/32024R1689
# Manually downloaded copy of that same document. Used if the fetch fails.
SOURCE_FALLBACK_PATH=data/raw/ai-act-oj-2024-1689.manual.html
# Upper bound on chunk size in characters. A starting value, to be checked against the
# embedder's token limit by the slow chunk-length test.
CHUNK_MAX_CHARS=1800

# --- Retrieval ------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# `real` loads the local models; `stub` is deterministic and downloads nothing (tests and CI).
EMBEDDER=real
RERANKER=real
# When true the app uses hybrid+rerank, otherwise hybrid.
RERANKER_ENABLED=false
# Chunks passed to the LLM.
TOP_K=5

# --- Generation -------------------------------------------------------------------
# "Not covered" gates, set from dev-split results. There is no default until they are tuned,
# and answering is not usable until they are set.
# Dense cosine similarity of the top-ranked chunk: used for bm25, dense and hybrid.
RELEVANCE_THRESHOLD_COSINE=
# Reranker score of the top-ranked chunk: used for hybrid+rerank.
RELEVANCE_THRESHOLD_RERANK=
# `openai` or `fake` (scripted replies for tests). Required to answer questions.
LLM_PROVIDER=
LLM_MODEL=
# Secret. Keep it only in your local `.env`.
LLM_API_KEY=
# Optional: point at an OpenAI-compatible server.
LLM_BASE_URL=
# Per-model prices in USD per million tokens, as JSON, for example:
#   {"your-model-name": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}}
# Required for paid use: a model without an entry is refused (the spend cap fails closed).
# Prices are your responsibility; none are shipped here.
LLM_PRICE_TABLE=
MAX_OUTPUT_TOKENS=500

# --- Public-demo safety limits ------------------------------------------------------
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_MINUTE=10
# Optional, e.g. X-Forwarded-For. When set, the client is identified by the LAST entry of that
# header, which assumes exactly one trusted proxy in front of the backend that appends it.
# Earlier entries are client-supplied and can be spoofed. Unset: the socket address is used.
TRUSTED_PROXY_HEADER=
# Daily spend cap in USD. If it cannot be checked, paid calls are refused (fails closed).
DAILY_SPEND_CAP_USD=1.00
# SQLite file holding the daily spend total. The default is the path inside the Docker volume;
# for a local run outside Docker, set it to a writable path such as ./data/spend.sqlite3.
SPEND_DB_PATH=/var/lib/askact/spend.sqlite3
# Origins allowed to call the backend, comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Evaluation and logging ---------------------------------------------------------
# Maximum uncached LLM calls in one evaluation run.
EVAL_MAX_LLM_CALLS=250
# Local debugging only. When true, the question text is added to the request log line.
# Leave false on the public demo: by default no question text is logged.
LOG_QUESTIONS=false

# --- Frontend (not read by Python) --------------------------------------------------
# BUILD-TIME value: Next.js bakes it into the client bundle when the UI is built, so changing it
# needs a rebuild of the UI image. For a deployment, set it to the PUBLIC URL of the backend
# (for example https://api.example.org) and add the UI's public origin to CORS_ORIGINS.
# The default only works for a local `docker compose up`.
NEXT_PUBLIC_API_URL=http://localhost:8000
